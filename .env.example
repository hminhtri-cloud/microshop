# For a NEW local database volume: replace these placeholder passwords.
# For an EXISTING volume: use the database credentials already initialized.
MYSQL_ROOT_PASSWORD=replace_with_local_root_password
MYSQL_DATABASE=auth_db
MYSQL_USER=microshop
MYSQL_PASSWORD=replace_with_local_app_password
# Generate a secret with: openssl rand -hex 32
JWT_SECRET=
JWT_EXPIRE_MINUTES=30
